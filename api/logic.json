            ],
            "where": {
              "type": "Exists",
              "operand": {
                "type": "Query",
                "source": [
                  {
                    "alias": "T",
                    "expression": {
                      "type": "Property",
                      "path": "type",
                      "scope": "E"
                    }
                  }
                ],
                "where": {
                  "type": "Equivalent",
