                    {
                      "type": "FunctionRef",
                      "libraryName": "FHIRHelpers",
                      "name": "ToConcept",
                      "operand": [
                        {
                          "type": "AliasRef",
                          "name": "T"
                        }
                      ]
                    },
                    {
                      "type": "CodeRef",
                      "name": "Referral Triage Code"
                    }
                  ]
                }
              }
            }
          }
        },
        {
