                  "scope": "Episode"
                },
                {
                  "type": "Literal",
                  "valueType": "{urn:hl7-org:elm-types:r1}String",
                  "value": "active"
                }
              ]
            }
          }
        },
        {
          "name": "Is Valid Referral Triage Process",
          "context": "Patient",
          "accessLevel": "Public",
          "expression": {
            "type": "Exists",
